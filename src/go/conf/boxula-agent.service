# Based on upstream Zabbix Agent 2 templates. Do not modify originals.
[Unit]
Description=Boxula Agent
After=syslog.target
After=network.target

[Service]
Environment="CONFFILE=/etc/boxula/boxula-agent.conf"
EnvironmentFile=-/etc/boxula/boxula-agent.conf
Type=forking
Restart=on-failure
PIDFile=/tmp/zabbix_agent2.pid
KillMode=control-group
ExecStart=/usr/sbin/zabbix_agent2 -c $CONFFILE
ExecStop=/bin/kill -SIGTERM $MAINPID
RestartSec=10s

[Install]
WantedBy=multi-user.target


